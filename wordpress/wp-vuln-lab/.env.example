# Copier en .env puis ajuster :  cp .env.example .env

# Port d'accès HTTP. Change-le (ou passe HTTP_PORT=... au make) pour lancer
# plusieurs instances en parallèle.
HTTP_PORT=8080

# Image WordPress. Le tag inclut la version de PHP, pratique pour rejouer
# un PoC dépendant d'une version PHP précise.
# Exemples : latest | 6.5 | 6.4-php8.1-apache | 5.9-php7.4-apache
WP_TAG=latest

# Identifiants admin du lab (aucune importance, c'est jetable)
WP_TITLE="Vuln Lab"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test

# Base de données
DB_NAME=wordpress
DB_USER=wp
DB_PASSWORD=wp
DB_ROOT_PASSWORD=root

# Logs PHP/WordPress (utile pour observer un PoC)
WP_DEBUG=1

LAB_NOTE="Une innovation par jour !"
