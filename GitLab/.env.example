# Copier en .env puis ajuster :  cp .env.example .env

# ---- VERSION DE GITLAB -----------------------------------------------
# Tag de l'image officielle gitlab/gitlab-ce.
# Format : <major>.<minor>.<patch>-ce.0
#
# Exemples :
#   latest               -> dernière stable
#   16.7.3-ce.0          -> version précise (format recommandé pour les CVE)
#   15.11.13-ce.0        -> branche 15.x
#   14.10.5-ce.0         -> branche 14.x
#   13.12.15-ce.0        -> branche 13.x (amd64 uniquement)
#   12.10.14-ce.0        -> branche 12.x (amd64 uniquement)
#   11.11.8-ce.0         -> branche 11.x (amd64 uniquement)
#
# Liste complète des tags : https://hub.docker.com/r/gitlab/gitlab-ce/tags
GITLAB_TAG=latest

# Port HTTP (l'interface web GitLab sera sur http://localhost:<HTTP_PORT>)
HTTP_PORT=8080

# Port SSH git (optionnel — pour cloner des repos via SSH pendant les tests)
SSH_PORT=2222
