# Copier en .env puis ajuster :  cp .env.example .env

# ---- VERSION DE GLPI -------------------------------------------------
# C'est le tag de l'image officielle glpi/glpi.
# Exemples : latest | 11.0.8 | 11.0 | 10.0.25 | 10.0
# Liste complète des tags disponibles :
#   https://hub.docker.com/r/glpi/glpi/tags
GLPI_TAG=latest

# Port d'accès HTTP. Change-le (ou passe HTTP_PORT=... au make) pour lancer
# plusieurs instances en parallèle.
HTTP_PORT=8080

# ---- Base de données -------------------------------------------------
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi
DB_ROOT_PASSWORD=root

# Laisser à false : GLPI s'installe automatiquement au 1er démarrage.
# Passer à true pour obtenir l'assistant web d'installation à la place.
GLPI_SKIP_AUTOINSTALL=false
