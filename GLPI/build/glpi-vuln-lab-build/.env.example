# Copier en .env puis ajuster :  cp .env.example .env

# ---- VERSION DE GLPI (obligatoire) -----------------------------------
# N'importe quelle version publiée sur les releases GitHub de GLPI, ex :
#   9.5.11 | 9.4.6 | 10.0.6 | 10.0.18 ...
# La liste : https://github.com/glpi-project/glpi/releases
GLPI_VERSION=9.5.11

# ---- VERSION DE PHP --------------------------------------------------
# À accorder avec GLPI_VERSION (voir le tableau dans le Dockerfile / README) :
#   GLPI 9.5.x -> 7.4   |   GLPI 10.0.x -> 7.4, 8.1 ou 8.2
PHP_VERSION=7.4

# ---- Divers ----------------------------------------------------------
HTTP_PORT=8080

GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi
DB_ROOT_PASSWORD=root
