# Copier en .env puis ajuster :  cp .env.example .env

# ---- VERSION JOOMLA (obligatoire) ------------------------------------
# Versions disponibles sur https://github.com/joomla/joomla-cms/releases
#
# Versions 4.x confirmees :
#   4.0.x : 4.0.0 a 4.0.6
#   4.1.x : 4.1.0, 4.1.2 a 4.1.5  (4.1.1 n'existe pas)
#   4.2.x : 4.2.0 a 4.2.9         (4.2.10+ n'existent pas)
#   4.3.x : 4.3.0 a 4.3.4         (4.3.5-4.3.6 n'existent pas)
#   4.4.x : 4.4.0 a 4.4.9
#
# Installation CLI automatique : uniquement 4.3.0+
# Pour 3.x, 4.0.x, 4.1.x, 4.2.x : wizard navigateur (voir provision.sh)
JOOMLA_VERSION=4.4.9

# ---- VERSION PHP -----------------------------------------------------
# Joomla 3.x       -> 7.4
# Joomla 4.0-4.2   -> 8.1
# Joomla 4.3-4.4   -> 8.1 ou 8.2
PHP_VERSION=8.1

HTTP_PORT=8080

# ---- Compte administrateur (Joomla 4.3.x et 4.4.x uniquement) -------
# Joomla 4.3+ impose un mdp > 12 caracteres
JOOMLA_SITE_NAME="Vuln Lab"
JOOMLA_ADMIN_USER="Admin"
JOOMLA_ADMIN_USERNAME=admin
JOOMLA_ADMIN_PASSWORD=Admin@VulnLab1
JOOMLA_ADMIN_EMAIL=admin@example.test

# ---- Base de donnees -------------------------------------------------
JOOMLA_DB_NAME=joomla
JOOMLA_DB_USER=joomla
JOOMLA_DB_PASSWORD=joomla
DB_ROOT_PASSWORD=root
