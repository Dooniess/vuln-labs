# Copier en .env puis ajuster :  cp .env.example .env

# ---- VERSION DE JOOMLA -----------------------------------------------
# Tag de l'image officielle Docker Hub (format : <version>-php<x.y>-apache)
# Images officielles disponibles : 5.x et 6.x uniquement.
# Pour les versions plus anciennes (4.x), utilisez le lab build.
# Liste complète des tags : https://hub.docker.com/_/joomla/tags
#
# Exemples :
#   latest                      -> dernière stable (6.x + PHP 8.4)
#   5.4.7                       -> Joomla 5.4.7 (PHP par défaut)
#   5.4.7-php8.2-apache         -> Joomla 5.4.7 + PHP 8.2
#   6.1.2-php8.3-apache         -> Joomla 6.1.2 + PHP 8.3
JOOMLA_TAG=latest

HTTP_PORT=8080

# ---- Compte administrateur -------------------------------------------
JOOMLA_SITE_NAME="Vuln Lab"
JOOMLA_ADMIN_USER="Admin"
JOOMLA_ADMIN_USERNAME=admin
# Joomla 6.x exige un mot de passe de plus de 12 caractères.
JOOMLA_ADMIN_PASSWORD=Admin@VulnLab1
JOOMLA_ADMIN_EMAIL=admin@example.test

# ---- Extensions à installer automatiquement --------------------------
# Chemins locaux (fichiers dans ./extensions/, un par ligne séparé par ;) :
# JOOMLA_EXTENSIONS_PATHS=/opt/local-extensions/mon-extension.zip
# URLs distantes :
# JOOMLA_EXTENSIONS_URLS=https://example.com/ext.zip
JOOMLA_EXTENSIONS_PATHS=
JOOMLA_EXTENSIONS_URLS=

# ---- Base de données -------------------------------------------------
JOOMLA_DB_NAME=joomla
JOOMLA_DB_USER=joomla
JOOMLA_DB_PASSWORD=joomla
DB_ROOT_PASSWORD=root
